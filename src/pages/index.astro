---
import Layout from '../layouts/Layout.astro';
import About from '../components/sections/home/About.astro';
import FAQ from "../components/sections/home/FAQ.astro";
import Hero from "../components/sections/home/Hero.astro";
import HomeIntro from "../components/sections/home/Intro.astro";
import BlogSlider from "../components/sections/home/Blog.astro";
import Industries from "../components/sections/home/Industries.astro";
import Portfolio from "../components/sections/home/Portfolio.astro";
import Services from "../components/sections/home/Services.astro";
import Process from "../components/sections/home/Process.astro";
import "@splidejs/splide/css/core";

// Constants
const title = "Scripting Pixels - Framer Templates and Resources";
const description = "Framer Templates for High-Impact Sites - Launch fast with premium templates built for speed, flexibility, and a modern web presence.";

---

<Layout {title} {description}>
  <Hero />
  <HomeIntro />
  <Industries />
  <Services />
  <Portfolio />
  <Process />
  <About />
  <BlogSlider />
  <FAQ />
</Layout>

<script>
  import Splide from "@splidejs/splide";

  const root = document.querySelector("#home-hero-projects-slider");

  if (root && !root.classList.contains("is-initialized")) {
    new Splide(root, {
      perPage: 5,
      perMove: 1,
      gap: "6px",
      arrows: false,
      pagination: false,
      breakpoints: {
        1024: { perPage: 3 },
        768: { perPage: 2 },
        480: { perPage: 1 },
      },
    }).mount();
  }
</script>
