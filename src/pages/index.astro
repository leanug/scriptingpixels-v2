---
import { getCollection } from "astro:content";

import Layout from '../layouts/Layout.astro';
import BlogList from '../components/BlogList/index.astro';
import PinnedPost from '../components/BlogList/PinnedPost.astro';

const blog = await getCollection('blog')
const pinned = blog.filter(p => p.data.pinned && p.data.published)

// Constants
const title = "Scripting Pixels - Framer Templates and Resources";
const description = "Framer Templates for High-Impact Sites - Launch fast with premium templates built for speed, flexibility, and a modern web presence.";
---

<Layout {title} {description}>
  <!-- Blog Intro -->
  <section class="max-w-2xl mx-auto mt-16 lg:mt-24 mb-8 md:mb-12 lg:mb-20 text-center">
    <h1 class="text-2xl md:text-4xl lg:text-5xl font-bold mb-6 text-balance">
      Design & Website Building Blog
    </h1>

    <p class="text-xl secondary-text text-balance text-base-content/70">
      UI design tips, Framer tutorials, and practical lessons for building and growing online.
    </p>
  </section>

  <!-- Pinned Post -->
  <section class="max-w-6xl mx-auto mb-16 flex flex-col md:flex-row gap-8">
    {pinned.map(post => <PinnedPost post={post} />)}
  </section>

  <div class="max-w-6xl mx-auto mt-12 lg:mt-16 mb-8">
    <h2 class="font-medium ml-6">All posts</h2>
  </div>

  <!-- Blog List -->
  <section class="max-w-6xl mx-auto mb-16 lg:mb-20">
    <BlogList />
  </section>
</Layout>
