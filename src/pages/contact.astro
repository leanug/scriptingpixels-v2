---
import Eyebrow from "../components/ui/Eyebrow.astro";
import Button from "../components/ui/Button.astro";
import FAQ from "../components/sections/home/FAQ.astro";
import Layout from "../layouts/Layout.astro";

const title = "Contact | Scripting Pixels";
const description = "Tell us about your project and let's make something great.";
---

<Layout {title} {description}>
  <section class="my-20">
    <div class="container">
      <header class="mb-12 max-w-3xl">
        <Eyebrow
          icon="heroicons:chat-bubble-left-right"
          text="Let's talk"
          variant="base-200"
          class="mb-6"
        />
        <h1 class="section-heading mb-0">
          Have a project in mind?
        </h1>
        <p class="mt-4 text-lg text-base-content/70">
          Got an idea in the works? Send over the details and I’ll get back to you to talk it through.
        </p>
      </header>

      <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
        <div class="border-t border-base-content/20 pt-8">
          <p class="mb-4 text-sm font-medium uppercase tracking-wider text-base-content/60">
            Prefer email?
          </p>
          <Button href="mailto:leandroubilla@protonmail.com" variant="secondary" icon="heroicons:envelope">
            Email me directly
          </Button>
        </div>

        <div class="border-t border-base-content/20 pt-8">
          <h2 class="mb-8 text-2xl font-semibold tracking-tight">Share a few details about your project.</h2>

          <form
            id="contact-form"
            action="https://api.web3forms.com/submit"
            method="POST"
            class="space-y-6"
          >
            <input type="hidden" name="access_key" value="b43a3ddc-d9d3-4113-a0fa-52bc2ba1e8ea" />
            <input type="hidden" name="subject" value="New contact request from Scripting Pixels" />
            <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" />

            <div>
              <label for="name" class="mb-2 block text-sm font-medium">Name</label>
              <input
                id="name"
                name="name"
                type="text"
                autocomplete="name"
                required
                maxlength="120"
                class="input input-bordered w-full rounded-lg bg-base-100"
              />
            </div>

            <div>
              <label for="email" class="mb-2 block text-sm font-medium">Email</label>
              <input
                id="email"
                name="email"
                type="email"
                autocomplete="email"
                required
                maxlength="254"
                class="input input-bordered w-full rounded-lg bg-base-100"
              />
            </div>

            <div>
              <label for="message" class="mb-2 block text-sm font-medium">Project details</label>
              <textarea
                id="message"
                name="message"
                rows="6"
                required
                maxlength="5000"
                class="textarea textarea-bordered w-full rounded-lg bg-base-100"
                placeholder="What are you looking to create?"
              ></textarea>
            </div>

            <Button type="submit" variant="dark" icon="heroicons:paper-airplane">
              Send message
            </Button>
            <p id="contact-status" class="min-h-6 text-sm text-base-content/70" aria-live="polite"></p>
          </form>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>("#contact-form");
  const status = document.querySelector<HTMLParagraphElement>("#contact-status");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!form || !status) return;

    const submitButton = form.querySelector<HTMLButtonElement>("button[type='submit']");
    if (submitButton) submitButton.disabled = true;
    status.textContent = "Sending your message…";

    try {
      const formData = new FormData(form);
      const response = await fetch("https://api.web3forms.com/submit", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Accept: "application/json",
        },
        body: JSON.stringify(Object.fromEntries(formData.entries())),
      });
      const result = await response.json();

      if (!response.ok || !result.success) {
        throw new Error(result.message || "We couldn't send your message. Please try again.");
      }

      form.reset();
      status.textContent = "Thanks for reaching out. Your message has been sent.";
    } catch (error) {
      status.textContent = error instanceof Error
        ? error.message
        : "Something went wrong. Please email me directly.";
    } finally {
      if (submitButton) submitButton.disabled = false;
    }
  });
</script>
