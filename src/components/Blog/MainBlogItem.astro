---
import { Image } from 'astro:assets';

const {
  image,
  title,
  description,
  author,
  slug,
  avatar
} = Astro.props;
---

<a href={`/blog/${slug}`} class="group w-full rounded">
  <article class="pb-8">
    <div class="overflow-hidden rounded-2xl">
      <Image
        transition:name={`img-${slug}`}
        src={`/media/blog/${slug}/${image}`}
        alt={`Cover of ${title}`}
        class="aspect-video w-full rounded-2xl object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
        width="800"
        height="450"
        decoding="async"
        loading="lazy"
      />
    </div>

    <div class="flex flex-col gap-4 mt-6">
      <h2 class="text-2xl font-semibold leading-snug">
        {title}
      </h2>

      <p class="text-base text-gray-700">{description}</p>

      <div class="flex items-center flex-wrap gap-3 text-gray-500">
        <Image
          src={`/media/authors/${avatar}`}
          alt="Author profile picture" 
          class="w-8 h-8 rounded-md"
          width="44" 
          height="44"
          decoding="async"
          loading="lazy"
        />
        {author && <span>By {author}</span>}
      </div>
    </div>
  </article>
</a>
