---
import { Image } from 'astro:assets';

const {
  image,
  title,
  slug,
  date
} = Astro.props;
---

<a href={`/blog/${slug}`} class="group w-full md:w-1/3 shrink-0 overflow-hidden rounded">
  <article class="flex flex-col sm:flex-row gap-4 md:items-center">
    <div class="w-full shrink-0 overflow-hidden rounded-xl sm:max-w-1/3">
      <Image
        transition:name={`img-${slug}`}
        src={`/media/blog/${slug}/${image}`}
        alt={`Cover of ${title}`}
        class="mx-auto aspect-video w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
        width="400"
        height="225"
        decoding="async"
        loading="lazy"
      />
    </div>

    <div class="space-y-4 w-full">
      <h2 class="text-xl font-semibold leading-snug group-hover:text-primary transition-colors">
        {title}
      </h2>
      <div class="text-lg font-semibold uppercase text-base-content/70">
        {date && <span>{new Date(date).toLocaleDateString()}</span>}
      </div>
    </div>
  </article>
</a>
