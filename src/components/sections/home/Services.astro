
---
import ServiceCard from "../../ui/ServiceCard.astro";
import Eyebrow from "../../ui/Eyebrow.astro";
import services from "../../../data/services";
---

<section id="services" class="section">
  <div class="container">
    <Eyebrow
      icon="heroicons:sparkles"
      text="WEBSITE DESIGN & DEVELOPMENT"
      class="badge-outline mb-8"
    />

    <h2 class="section-heading">
      Let's build a website that makes a strong first impression.
    </h2>

    <div class="grid grid-cols-1 gap-x-12 gap-y-16 sm:grid-cols-3">
      {services.map((service) => (
        <ServiceCard {...service} />
      ))}
    </div>
  </div>
</section>
