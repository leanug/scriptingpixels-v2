---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import Button from "../../ui/Button.astro";
import Eyebrow from "../../ui/Eyebrow.astro";
import ProjectCard from "../../ui/ProjectCard.astro";

const featuredWork = await getCollection("work", ({ data }) => data.featured === true);

const projects = featuredWork
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
  .map(({ id, data }) => ({
    id,
    title: data.title,
    category: data.category,
    date: data.date
      ? `_${String(data.date.getMonth() + 1).padStart(2, "0")}.${String(data.date.getFullYear()).slice(-2)}`
      : undefined,
    image: data.img ? `/media/work/${id}/${data.img}` : undefined,
  }));
---

<section id="projects" class="section bg-base-100">
  <div class="container">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] md:gap-10 lg:gap-40">
      <!-- Intro -->
      <div class="md:sticky md:top-10 md:h-fit">
        <Eyebrow
          icon="heroicons:rectangle-stack"
          text="In the field"
          class="badge-outline"
          variant="base-200"
        />
        <h2 class="section-heading mb-4">
          Previous work
        </h2>

        <div class="mb-7 space-y-3 text-base-content/70">
          <p>Websites should feel as good as they work.</p>
          <p class="text-balance">
            Clean but distinctive. Strategic but never overcomplicated.
            Every project is designed around the brand, the audience,
            and the experience it needs to deliver.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <Button variant="secondary" href="/work" icon="heroicons:squares-2x2" class="[&_svg]:text-base-content/70">View all work</Button>
        </div>
        <div class="mt-6 grid grid-cols-2 gap-3" aria-label="Experience and services">
          <div class="rounded-xl bg-base-200 p-4">
            <div class="mb-3 flex items-center gap-3">
              <span class="grid size-9 shrink-0 place-items-center rounded-lg bg-base-100" aria-hidden="true">
                <Icon name="heroicons:briefcase" class="size-[18px]" />
              </span>
              <p class="text-lg font-semibold tracking-tight sm:text-xl">10+ years</p>
            </div>
            <p class="text-sm leading-5 text-base-content/65">Designing for the web.</p>
          </div>
          <div class="rounded-xl bg-base-200 p-4">
            <div class="mb-3 flex items-center gap-3">
              <span class="grid size-9 shrink-0 place-items-center rounded-lg bg-base-100" aria-hidden="true">
                <Icon name="heroicons:code-bracket" class="size-[18px]" />
              </span>
              <p class="text-lg font-semibold tracking-tight sm:text-xl">Webflow or Code</p>
            </div>
            <p class="text-sm leading-5 text-base-content/65">The right approach for your project.</p>
          </div>
        </div>
      </div>

      <!-- Project list -->
      <div class="flex min-w-0 flex-col gap-3">
        {projects.map((project) => (
          <ProjectCard
            id={project.id}
            title={project.title}
            category={project.category}
            date={project.date}
            image={project.image}
            variant="featured"
          />
        ))}
      </div>
    </div>
  </div>
</section>
