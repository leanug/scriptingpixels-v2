---
import Eyebrow from "../../ui/Eyebrow.astro";
import Button from "../../ui/Button.astro";
---

<div class="grid gap-5 px-6 pb-7 pt-7 sm:grid-cols-[1.5fr_0.7fr] sm:items-end sm:px-12 sm:pt-40 lg:grid-cols-3 lg:gap-2 lg:px-16">
    <div class="lg:col-span-2">
        <Eyebrow
            icon="heroicons:sparkles"
            text="WEBSITE DESIGN & DEVELOPMENT"
            class="badge-outline mb-6"
        />

        <h1 class="max-w-2xl text-[clamp(2rem,4.5vw,5rem)] text-balance font-semibold leading-18 tracking-tighter">
            Thoughtful web design that turns visitors into clients.
        </h1>
    </div>

    <div class="flex flex-col items-start gap-8 sm:items-start sm:pb-1 lg:col-start-3">
        <p class="max-w-96 text-2xl leading-8 text-base-content">
            Helping businesses build trust, stand out, and grow online.
        </p>
        
        <Button variant="dark" href="/contact">Start Your Project</Button>
    </div>
</div>
