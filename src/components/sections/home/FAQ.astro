---
import { faqs } from "../../../data/faq";
import { Icon } from "astro-icon/components";
import Button from "../../ui/Button.astro";
---

<section id="faq" class="section bg-base-100">
  <div class="container">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2 md:gap-12">
      <div>
        <h2 class="section-heading">
          FAQ.
        </h2>
        <p class="max-w-sm text-base leading-6 text-base-content/70">
          Have questions about your project? Get in touch to explore the right next steps.
        </p>
        <Button
          href="/contact"
          variant="secondary"
          class="mt-6 normal-case"
        >
          <Icon name="heroicons:chat-bubble-left-right" class="size-[18px]" aria-hidden="true" />
          Get in touch
        </Button>
      </div>

      <div class="flex flex-col gap-1.5">
        {faqs.map((faq, index) => (
          <div class="accordion">
            <input
              id={`faq-toggle-${index}`}
              class="accordion-input peer sr-only"
              type="checkbox"
              checked={index === 0}
            />

            <label
              for={`faq-toggle-${index}`}
              class="accordion-header flex cursor-pointer items-center justify-between gap-5 rounded-xl bg-base-300/60 px-5 py-4 text-md font-medium select-none peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2"
            >
              <span>{faq.question}</span>

              <span class="relative size-5 shrink-0 text-base-content">
                <Icon
                  name="heroicons:plus"
                  class="accordion-plus absolute inset-0 size-5 transition-all duration-200 ease-out"
                  aria-hidden="true"
                />
                <Icon
                  name="heroicons:minus"
                  class="accordion-minus absolute inset-0 size-5 scale-0 opacity-0 transition-all duration-200 ease-out"
                  aria-hidden="true"
                />
              </span>
            </label>

            <div class="accordion-content text-base-content/70">
              <div class="accordion-inner px-5">
                <div class="accordion-answer">{faq.answer}</div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .accordion-content {
    display: grid;
    grid-template-rows: 0fr;
    overflow: hidden;
    transition: grid-template-rows 300ms ease-out;
  }

  .accordion-inner {
    min-height: 0;
    overflow: hidden;
    padding-top: 0;
    padding-bottom: 0;
    transition: padding 300ms ease-out;
  }

  .accordion-input:checked ~ .accordion-content {
    grid-template-rows: 1fr;
  }

  .accordion-input:checked ~ .accordion-content .accordion-inner {
    padding-top: 1rem;
    padding-bottom: 0.75rem;
  }

  .accordion-input:checked ~ .accordion-header .accordion-plus {
    transform: rotate(90deg) scale(0);
    opacity: 0;
  }

  .accordion-input:checked ~ .accordion-header .accordion-minus {
    scale: 1;
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .accordion-content,
    .accordion-inner,
    .accordion-plus,
    .accordion-minus {
      transition-duration: 0ms;
    }
  }
</style>
