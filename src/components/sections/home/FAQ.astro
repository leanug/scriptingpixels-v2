---
import { faqs } from "../../../data/faq";
import { Plus, Minus } from "@lucide/astro";
---

<section
  id="faq"
  class="grid grid-cols-1 gap-8 bg-base-200 px-6 py-16 sm:px-10 md:grid-cols-2 md:gap-12 lg:px-5 lg:py-20"
>
  <div>
    <h2 class="section-heading">
      FAQ.
    </h2>
  </div>

  <div class="flex flex-col gap-2">
    {faqs.map((faq, index) => (
      <div class="accordion rounded-sm bg-base-300/60">
        <input
          id={`faq-toggle-${index}`}
          class="accordion-input peer sr-only"
          type="checkbox"
          checked={index === 0}
        />

        <label
          for={`faq-toggle-${index}`}
          class="accordion-header flex cursor-pointer items-center justify-between gap-4 px-5 py-4 text-lg font-medium select-none peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2"
        >
          <span>{faq.question}</span>

          <span class="relative size-6 shrink-0 text-base-content">
            <Plus
              size={24}
              class="accordion-plus absolute inset-0 transition-all duration-200 ease-out"
            />
            <Minus
              size={24}
              class="accordion-minus absolute inset-0 scale-0 opacity-0 transition-all duration-200 ease-out"
            />
          </span>
        </label>

        <div class="accordion-content text-base-content/70">
          <div class="accordion-inner px-5">
            <div class="accordion-answer">{faq.answer}</div>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .accordion-content {
    display: grid;
    grid-template-rows: 0fr;
    overflow: hidden;
    transition: grid-template-rows 300ms ease-out;
  }

  .accordion-inner {
    min-height: 0;
    overflow: hidden;
    padding-bottom: 0;
    transition: padding 300ms ease-out;
  }

  .accordion-input:checked ~ .accordion-content {
    grid-template-rows: 1fr;
  }

  .accordion-input:checked ~ .accordion-content .accordion-inner {
    padding-bottom: 1rem;
  }

  .accordion-input:checked ~ .accordion-header .accordion-plus {
    transform: rotate(90deg) scale(0);
    opacity: 0;
  }

  .accordion-input:checked ~ .accordion-header .accordion-minus {
    scale: 1;
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .accordion-content,
    .accordion-inner,
    .accordion-plus,
    .accordion-minus {
      transition-duration: 0ms;
    }
  }
</style>
