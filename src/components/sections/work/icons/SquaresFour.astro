---
interface Props {
  class?: string;
}

const { class: className = "size-10 text-base-content" } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 256 256"
  fill="none"
  stroke="currentColor"
  stroke-width="16"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  focusable="false"
>
  <rect x="32" y="32" width="80" height="80" rx="8" />
  <rect x="144" y="32" width="80" height="80" rx="8" />
  <rect x="32" y="144" width="80" height="80" rx="8" />
  <rect x="144" y="144" width="80" height="80" rx="8" />
</svg>
