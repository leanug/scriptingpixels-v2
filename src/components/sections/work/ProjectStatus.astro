---
interface Props {
  status: string;
}

const { status } = Astro.props;
const isDelivered = status === "Delivered";
---

<span class="label gap-1.5 rounded-full bg-base-200 px-3 py-2 text-sm font-medium text-base-content">
  <span class:list={[
    "w-1.5 h-1.5 rounded-full inline-block",
    isDelivered ? "bg-green-500" : "bg-warning",
  ]}></span>
  {status}
</span>
