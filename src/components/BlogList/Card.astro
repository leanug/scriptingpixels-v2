---
const { image, title, slug } = Astro.props;
---

<article class="group p-6 rounded-3xl bg-base-200 hover:bg-base-300 transition-colors duration-300">
  <a 
    class="rounded-xl group"
    href={`/blog/${slug}`}>
    <img
      src={`/media/blog/${slug}/${image}`}
      alt={title}
      width="800"
      height="450"
      decoding="async"
      loading="lazy"
      class="rounded-xl object-cover w-full aspect-video"
    />
    <h3 class="text-lg font-medium mt-4 leading-6">{title}</h3>
  </a>
</article>
