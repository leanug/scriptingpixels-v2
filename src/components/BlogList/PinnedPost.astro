---
import { type CollectionEntry } from "astro:content";
import { Image } from 'astro:assets';

interface Props {
  post: CollectionEntry<'blog'>
}

const { post } = Astro.props;
const imagePath = `/media/blog/${post.id}/${post.data.image}`;
---

<article class="space-y-6 w-full p-6 bg-base-200 hover:bg-base-300 transition-colors duration-300 rounded-3xl">
  <a class="rounded-xl group" href={`/blog/${post.id}`}>
    <Image
      src={imagePath}
      alt={post.data.title}
      width="800"
      height="450"
      decoding="async"
      loading="lazy"
      class="rounded-xl object-cover w-full aspect-video"
    />
    <h2 class="text-2xl md:text-3xl font-semibold leading-tight mt-7 mb-4 text-balance">
      {post.data.title}
    </h2>
    <p class="text-lg max-w-3xl text-balance text-base-content/70">
      {post.data.description}
    </p>
  </a>
</article>