
---
import Card from "./Card.astro";

import "@splidejs/splide/css/core";

import { getCollection } from "astro:content";
import Eyebrow from "../ui/Eyebrow.astro";

const blog = await getCollection('blog')
const mainPosts = blog
  .filter((post) => post.data.published)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
---

<section class="overflow-hidden bg-base-100 py-16 text-base-content sm:py-20">
  <div class="mb-8 grid grid-cols-1 items-end gap-5 px-6 sm:grid-cols-[1fr_260px] sm:px-10">
    <div>
      <Eyebrow
        icon="heroicons:sparkles"
        text="FROM THE BLOG"
        class="badge-outline mb-6"
      />
      <h2 class="section-heading">
        Design &amp; Web Development
      </h2>
    </div>

    <p class="max-w-[260px] text-xs leading-relaxed text-base-content/70">
      Thoughts and lessons from designing and building for the web.
    </p>
  </div>

  <div id="home-blog-slider" class="splide" aria-label="Latest blog posts">
    <div class="splide__track">
      <ul class="splide__list">
        {mainPosts.map((post) => (
          <li class="splide__slide">
            <Card
              image={post.data.image ?? "cover.webp"}
              title={post.data.title}
              slug={post.id}
            />
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="mt-8 flex items-center justify-between px-6 sm:px-10">
    <div id="home-blog-pagination"></div>

    <div class="flex gap-2">
      <button type="button" class="btn btn-circle btn-sm border-0 bg-base-200" data-prev aria-label="Previous posts">
        ←
      </button>
      <button type="button" class="btn btn-circle btn-sm border-0 bg-base-200" data-next aria-label="Next posts">
        →
      </button>
    </div>
  </div>
</section>

<script>
  import Splide from "@splidejs/splide";

  const root = document.querySelector("#home-blog-slider");

  if (root && !root.classList.contains("is-initialized")) {
    const splide = new Splide(root, {
      perPage: 3.4,
      perMove: 1,
      gap: "12px",
      arrows: false,
      pagination: true,
      breakpoints: {
        1024: { perPage: 2.5 },
        640: { perPage: 1.2, gap: "10px" },
      },
    });

    splide.on("pagination:mounted", ({ list }) => {
      const pagination = document.querySelector("#home-blog-pagination");
      if (pagination) pagination.appendChild(list);
    });

    splide.mount();

    document.querySelector("[data-prev]")?.addEventListener("click", () => splide.go("<"));
    document.querySelector("[data-next]")?.addEventListener("click", () => splide.go(">"));
  }
</script>

<style>
  #home-blog-slider .splide__slide {
    height: auto;
  }

  #home-blog-pagination :global(.splide__pagination) {
    position: static;
    display: flex;
    justify-content: flex-start;
    gap: 4px;
    padding: 0;
  }

  #home-blog-pagination :global(.splide__pagination__page) {
    width: 4px;
    height: 4px;
    margin: 0;
    background: #b8b8b8;
    opacity: 1;
  }

  #home-blog-pagination :global(.splide__pagination__page.is-active) {
    width: 22px;
    border-radius: 999px;
    background: #1677ff;
    transform: none;
  }
</style>
