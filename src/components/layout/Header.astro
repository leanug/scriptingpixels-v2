---
import Logo from "../ui/Logo.astro";
import { Icon } from 'astro-icon/components'
import ThemeToggle from '../../components/ui/ThemeToggle.astro';
---

<header class="mt-5 flex sm:items-center flex-col sm:flex-row justify-between gap-4 text-sm font-medium tracking-wide">
  <div class="flex-1">
    <Logo />
  </div>
  <div class="flex-none flex items-center gap-3">
    <a 
      href="https://leandroubilla.com" 
      target="_blank" 
      class="btn rounded-full btn-outline"
      aria-label="Visit my portfolio and hire me to build your website">
      <Icon name="heroicons:computer-desktop-solid" class="w-4 h-4" />
      Need a Website?
    </a>
    <ThemeToggle />
  </div>
</header>