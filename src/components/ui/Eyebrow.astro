---
import { Icon } from "astro-icon/components";

type Props = {
  icon: string;
  text: string;
  variant?: "base" | "base-200";
  iconClass?: string;
  textClass?: string;
  borderClass?: string;
  backgroundClass?: string;
  class?: string;
};

const {
  icon,
  text,
  variant = "base",
  iconClass,
  textClass,
  borderClass,
  backgroundClass,
  class: className = "",
} = Astro.props;

const variantClasses = {
  base: {
    icon: "text-base-content/70",
    text: "text-base-content",
    border: "border-base-100",
    background: "bg-base-100",
  },
  "base-200": {
    icon: "text-base-content/70",
    text: "text-base-content",
    border: "border-base-200",
    background: "bg-base-200",
  },
}[variant];

const colors = {
  icon: iconClass ?? variantClasses.icon,
  text: textClass ?? variantClasses.text,
  border: borderClass ?? variantClasses.border,
  background: backgroundClass ?? variantClasses.background,
};
---

<span
  class={`badge group inline-flex items-center gap-1.5 rounded-full border pl-3 pr-3.5 py-5 mb-5 text-sm font-semibold ${colors.text} ${colors.border} ${colors.background} ${className}`}
>
  <Icon
    name={icon}
    class={`size-4 ${colors.icon} transition-transform duration-300 ease-out group-hover:rotate-45 motion-reduce:transition-none`}
    aria-hidden="true"
  />
  {text}
</span>
