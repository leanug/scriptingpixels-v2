---
import { Icon as HeroIcon } from "astro-icon/components";
import Button from "./Button.astro";

interface Props {
  number: string;
  duration: string;
  icon: string;
  title: string;
  price: string;
  description: string;
  features: { text: string; icon: string }[];
}

const { number, duration, icon: Icon, title, description, features, price } = Astro.props;
---

<article class="flex h-full min-w-0 flex-col rounded-3xl bg-base-100 p-5 sm:p-6">
  <div class="mb-5 flex items-center justify-between gap-3">
    <div class="flex items-center gap-2.5">
      <HeroIcon name={Icon} class="size-5 text-base-content/70" aria-hidden="true" />
      <span class="font-mono text-md tracking-tight">{title}</span>
    </div>
    <span class="badge h-auto border-0 bg-base-200 px-3.5 py-2 text-xs rounded-full text-base-content/70">
      {duration}
    </span>
  </div>

  <div class="mb-5">
    <p class="mb-2 text-xs text-base-content/60">Starting at</p>
    <p class="text-3xl font-semibold tracking-tight text-base-content">{price}</p>
  </div>
  <p class="min-h-12 text-md leading-relaxed text-base-content/65">{description}</p>

  <div class="mt-6 mb-8 border-t border-base-content/10"></div>

  <ul class="mb-9 flex-1 space-y-3 text-sm leading-4 text-base-content">
    {features.map(({ text, icon }) => (
      <li class="flex items-start gap-2.5">
        <HeroIcon name={icon} class="mt-[-1px] size-4 shrink-0 text-base-content/70" aria-hidden="true" />
        <span>{text}</span>
      </li>
    ))}
  </ul>

  <Button
    href="/contact"
    variant="dark"
    icon="heroicons:arrow-up-right"
    class="h-11 min-h-11 w-full rounded-lg border-0 px-4 py-0"
  >
    Start Your Project
  </Button>
</article>
